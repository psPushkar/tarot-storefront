# ─────────────────────────────────────────────────────────────
#  Storefront configuration
#  Copy this file to `.env` and fill in real values.
#  Everything prefixed PUBLIC_ is exposed to the browser. That is
#  intentional and safe: a pk_ key grants exactly what an anonymous
#  visitor may do. NEVER put an sk_ key in this file.
# ─────────────────────────────────────────────────────────────

# The canonical public URL of THIS website. Used for canonical tags,
# OpenGraph URLs, the sitemap and Stripe return URLs.
PUBLIC_SITE_URL="https://example.com"

# Base URL of the booking platform deployment, including /api/v1.
# e.g. https://app.yourplatform.com/api/v1
PUBLIC_API_BASE_URL=""

# Public storefront API key issued from Admin → API keys.
PUBLIC_API_KEY=""

# When true, the site renders a bundled demo catalogue instead of
# calling the API. Leave unset: it turns itself on automatically
# whenever PUBLIC_API_BASE_URL / PUBLIC_API_KEY are missing, so the
# site always builds and always looks finished.
# Set to "false" to force real API calls and surface real error states.
PUBLIC_DEMO_MODE=""

# Milliseconds before an API call is abandoned and the page falls back
# to its designed empty state. Keep this well under your host's timeout.
PUBLIC_API_TIMEOUT_MS="8000"
