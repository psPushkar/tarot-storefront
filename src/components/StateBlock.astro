---
/**
 * StateBlock — the house style for every non-happy path.
 *
 * The brief was explicit: when data is missing or a call fails, the page must
 * still look composed and say so gracefully. Routing all of those moments
 * through one component is what makes that true in practice rather than in
 * intention — there is no code path that can render a raw error string.
 *
 * `tone="ceremonial"` is a full-width, centred takeover for when the whole page
 * depends on the failed call. `tone="inline"` is a quiet panel for when one
 * section failed and the rest of the page is fine.
 */

import Ornament from './Ornament.astro';

interface Action {
  label: string;
  href: string;
  variant?: 'primary' | 'ghost';
}

interface Props {
  heading: string;
  body: string;
  /** Rendered under the body in a smaller, quieter face. */
  note?: string;
  tone?: 'ceremonial' | 'inline';
  actions?: Action[];
  /** Show the hairline divider under the heading. Ceremonial only. */
  divider?: boolean;
  /** Guilloché card-back wash, used on 404. */
  pattern?: boolean;
  /**
   * Heading level. A state block is usually one section among many, so it
   * defaults to `h2`; pages where it *is* the page (404, a fully-failed load)
   * pass `h1` so the document still has exactly one top-level heading.
   */
  headingLevel?: 'h1' | 'h2';
  class?: string;
}

const {
  heading,
  body,
  note,
  tone = 'ceremonial',
  actions = [],
  divider = true,
  pattern = false,
  headingLevel: Heading = 'h2',
  class: className = '',
} = Astro.props;
---

{
  tone === 'ceremonial' ? (
    <section class:list={['state', className]}>
      {pattern && <div class="state__pattern guilloche" aria-hidden="true" />}
      <div class="state__inner">
        <Ornament motif="star" size={44} class="state__star" />
        <Heading class="state__heading">{heading}</Heading>        {divider && <Ornament motif="divider" class="state__divider" />}
        <p class="state__body">{body}</p>
        {note && <p class="state__note">{note}</p>}
        {actions.length > 0 && (
          <div class="state__actions">
            {actions.map((action) => (
              <a
                href={action.href}
                class:list={['btn', action.variant === 'primary' ? 'btn-primary' : 'btn-ghost']}
              >
                {action.label}
              </a>
            ))}
          </div>
        )}
        <slot />
      </div>
    </section>
  ) : (
    <div class:list={['state-inline', className]}>
      <Ornament motif="star" size={16} class="state-inline__star" />
      <div>
        <p class="state-inline__heading">{heading}</p>
        <p class="state-inline__body">{body}</p>
        {note && <p class="state-inline__note">{note}</p>}
        {actions.length > 0 && (
          <div class="state-inline__actions">
            {actions.map((action) => (
              <a href={action.href} class="link-onward">
                {action.label}
                <Ornament motif="arrow" size={14} />
              </a>
            ))}
          </div>
        )}
        <slot />
      </div>
    </div>
  )
}

<style>
  .state {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: clamp(64px, 10vw, 140px);
    padding-inline: var(--shell-gutter);
    overflow: hidden;
  }
  .state__pattern {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    pointer-events: none;
  }
  .state__inner {
    position: relative;
    max-inline-size: 460px;
    text-align: center;
  }
  .state__star {
    display: block;
    margin-inline: auto;
    color: var(--color-gold-dim);
    opacity: 0.3;
  }
  .state__heading {
    margin-block-start: 28px;
    font-size: var(--text-display-md);
    color: var(--color-ink);
  }
  .state__divider {
    display: block;
    margin-block: 24px;
    color: var(--color-gold-dim);
  }
  .state__body {
    font-size: var(--text-copy);
    color: var(--color-ink-soft);
  }
  .state__note {
    margin-block-start: 14px;
    font-size: var(--text-copy-sm);
    color: var(--color-ink-muted);
  }
  .state__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-block-start: 32px;
  }

  .state-inline {
    display: flex;
    gap: 14px;
    padding: 24px;
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }
  .state-inline__star {
    flex: none;
    margin-block-start: 3px;
    color: var(--color-gold-dim);
    opacity: 0.6;
  }
  .state-inline__heading {
    font-family: var(--font-display);
    font-size: var(--text-display-sm);
    color: var(--color-ink);
  }
  .state-inline__body {
    margin-block-start: 6px;
    max-inline-size: 58ch;
    font-size: var(--text-copy-sm);
    color: var(--color-ink-soft);
  }
  .state-inline__note {
    margin-block-start: 8px;
    font-size: var(--text-fine);
    color: var(--color-ink-muted);
  }
  .state-inline__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-block-start: 16px;
  }
</style>
