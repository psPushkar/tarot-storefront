---
import { clampRating, formatDateShort } from '../lib/format';
import type { Review } from '../lib/types';
import Ornament from './Ornament.astro';

interface Props {
  review: Review;
}

const { review } = Astro.props;
const rating = clampRating(review.rating);
---

<figure class="card review-card" data-reveal>
  <blockquote class="review-card__quote">
    <p>{review.comment}</p>
  </blockquote>

  <figcaption class="review-card__foot">
    <span class="review-card__stars" role="img" aria-label={`${rating} out of 5`}>
      {Array.from({ length: rating }).map(() => <Ornament motif="star" size={11} />)}
    </span>
    {
      review.created_at && (
        <time datetime={review.created_at.slice(0, 10)}>{formatDateShort(review.created_at)}</time>
      )
    }
  </figcaption>
</figure>

<style>
  .review-card {
    gap: 20px;
    block-size: 100%;
  }

  .review-card__quote {
    flex: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-ink);
    border-inline-start: 2px solid var(--color-line-gold);
    padding-inline-start: clamp(16px, 2.5vw, 24px);
  }

  .review-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block-start: 18px;
    border-block-start: 1px solid var(--color-line);
    font-size: var(--text-fine);
    color: var(--color-ink-muted);
  }

  .review-card__stars {
    display: inline-flex;
    gap: 4px;
    color: var(--color-gold);
  }
</style>
