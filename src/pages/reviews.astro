---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import { photos } from '../lib/photos';
import StateBlock from '../components/StateBlock.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getBrand } from '../lib/brand';
import { getCachedReviews, averageRating } from '../lib/catalogue';
import { breadcrumbSchema, reviewsSchema } from '../lib/schema';
import { reviewsIntro } from '../lib/content';

const { profile } = await getBrand();
const { reviews, ok } = await getCachedReviews();
const avg = averageRating(reviews);

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews' },
];
---

<Base
  title="Reviews"
  description="Read what clients say about their tarot readings with Aurelia Sable. Unedited testimonials from people at turning points who chose to share their experience."
  schemas={[reviewsSchema(reviews, profile), breadcrumbSchema(trail)]}
>
  <PageHeader variant="ceremonial" eyebrow={reviewsIntro.eyebrow} heading={reviewsIntro.heading} lede={reviewsIntro.body} trail={trail} />

  <section class="section reviews-section" aria-label="Client reviews">
    <Photo
      photo={photos.blackVelvet}
      treatment="wash"
      fill={true}
      width={1600}
      sizes="100vw"
      decorative={true}
      rounded={false}
    />
    <div class="shell reviews-section__inner">
    {!ok ? (
      <StateBlock
        heading="This section couldn't be loaded right now."
        body="Please refresh the page to try again. Everything else on the site is working normally."
        tone="ceremonial"
        actions={[
          { label: 'Return home', href: '/' },
          { label: 'View readings', href: '/services' },
        ]}
      />
    ) : reviews.length === 0 ? (
      <StateBlock
        heading="No reviews published yet."
        body="Reviews appear here once clients choose to share them. In the meantime, you're welcome to read about the practice or get in touch."
        tone="ceremonial"
        actions={[
          { label: 'About the practice', href: '/about' },
          { label: 'Get in touch', href: '/contact' },
        ]}
      />
    ) : (
      <>
        {avg !== null && (
          <div class="reviews-aggregate" data-reveal>
            <p class="reviews-aggregate__rating">{avg.toFixed(1)}</p>
            <p class="reviews-aggregate__label">average across {reviews.length} {reviews.length === 1 ? 'review' : 'reviews'}</p>
          </div>
        )}
        <div class="reviews-masonry" data-reveal-group>
          {reviews.map((review) => (
            <ReviewCard review={review} />
          ))}
        </div>
      </>
    )}
    </div>
  </section>
</Base>

<style>
  .reviews-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .reviews-section__inner {
    position: relative;
    z-index: 1;
  }
  .reviews-aggregate {
    text-align: center;
    margin-block-end: var(--section-y-sm);
  }
  .reviews-aggregate__rating {
    font-family: var(--font-display);
    font-size: var(--text-display-xl);
    color: var(--color-gold);
    font-weight: 300;
  }
  .reviews-aggregate__label {
    margin-block-start: 8px;
    font-size: var(--text-copy-sm);
    color: var(--color-ink-muted);
  }
  .reviews-masonry {
    columns: 1;
    column-gap: 24px;
  }
  .reviews-masonry > :global(.review-card) {
    break-inside: avoid;
    margin-block-end: 24px;
  }
  @media (min-width: 640px) {
    .reviews-masonry {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .reviews-masonry {
      columns: 3;
    }
  }
</style>
