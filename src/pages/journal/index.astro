---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Ornament from '../../components/Ornament.astro';
import Photo from '../../components/Photo.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { journalIntro, articles } from '../../lib/content';
import { articlePhoto } from '../../lib/articleImages';
import { formatDateShort } from '../../lib/format';

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Journal', path: '/journal' },
];

const sorted = [...articles].sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
);
const featured = sorted[0];
const rest = sorted.slice(1);
---

<Base
  title="Journal"
  description="Essays on tarot, grief, decision-making and the history of the deck. Written for people who are curious about the practice but suspicious of mystification."
  schemas={[breadcrumbSchema(trail)]}
>
  <PageHeader variant="ceremonial" eyebrow={journalIntro.eyebrow} heading={journalIntro.heading} lede={journalIntro.body} trail={trail} />

  {featured && (
    <section class="section shell" aria-label="Featured article" data-reveal>
      <div class="journal-featured">
        <Ornament motif="flourish" size={40} class="journal-featured__flourish" />
        {articlePhoto(featured.slug) && (
          <a href={`/journal/${featured.slug}`} class="journal-featured__figure" tabindex="-1" aria-hidden="true">
            <Photo
              photo={articlePhoto(featured.slug)!}
              ratio="wide"
              width={760}
              sizes="(min-width: 760px) 680px, 100vw"
              eager={true}
              decorative={true}
            />
          </a>
        )}
        <p class="eyebrow">{featured.category}</p>
        <h2 class="journal-featured__title">
          <a href={`/journal/${featured.slug}`}>{featured.title}</a>
        </h2>
        <p class="journal-featured__dek">{featured.dek}</p>
        <p class="journal-featured__meta">
          <time datetime={featured.publishedAt}>{formatDateShort(featured.publishedAt)}</time>
          <span aria-hidden="true">&middot;</span>
          {featured.readingMinutes} minutes
        </p>
      </div>
    </section>
  )}

  <section class="section-sm shell" aria-label="All articles">
    <ol class="journal-index" role="list" data-reveal-group>
      {rest.map((article) => (
        <li class="journal-row" data-reveal>
          <div class="journal-row__meta">
            <time datetime={article.publishedAt}>{formatDateShort(article.publishedAt)}</time>
            <span class="journal-row__cat">{article.category}</span>
          </div>
          <div class="journal-row__body">
            <h2 class="journal-row__title">
              <a href={`/journal/${article.slug}`}>{article.title}</a>
            </h2>
            <p class="journal-row__dek">{article.dek}</p>
          </div>
          {articlePhoto(article.slug) && (
            <div class="journal-row__thumb" aria-hidden="true">
              <Photo
                photo={articlePhoto(article.slug)!}
                ratio="square"
                width={200}
                sizes="120px"
                decorative={true}
              />
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  /* Featured article */
  .journal-featured {
    position: relative;
    max-inline-size: 680px;
    margin-inline: auto;
    text-align: center;
  }
  .journal-featured__flourish {
    position: absolute;
    inset-block-start: -20px;
    inset-inline-end: -20px;
    color: var(--color-gold-dim);
  }
  .journal-featured__title {
    font-size: var(--text-display-md);
    color: var(--color-ink);
    margin-block-start: 16px;
  }
  .journal-featured__title a {
    transition: color 200ms var(--ease-subtle);
  }
  .journal-featured__title a:hover {
    color: var(--color-gold);
  }
  .journal-featured__dek {
    margin-block-start: 16px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lead);
    color: var(--color-ink-soft);
    max-inline-size: 55ch;
    margin-inline: auto;
  }
  .journal-featured__meta {
    margin-block-start: 20px;
    font-size: var(--text-fine);
    color: var(--color-ink-muted);
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .journal-featured__figure {
    display: block;
    margin-block-end: clamp(28px, 4vw, 44px);
  }
  .journal-featured__figure :global(.photo) {
    transition:
      transform 500ms var(--ease-smooth),
      box-shadow 500ms var(--ease-smooth);
  }
  .journal-featured:hover .journal-featured__figure :global(.photo) {
    transform: scale(1.012);
    box-shadow: var(--shadow-lg);
  }
  @media (prefers-reduced-motion: reduce) {
    .journal-featured:hover .journal-featured__figure :global(.photo) {
      transform: none;
    }
  }

  /* Index list */
  .journal-index {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .journal-row {
    display: grid;
    grid-template-columns: 132px 1fr 108px;
    gap: 24px;
    align-items: center;
    padding-block: clamp(20px, 2.5vw, 32px);
    border-block-end: 1px solid var(--color-line);
  }
  .journal-row__thumb {
    inline-size: 108px;
    opacity: 0.72;
    transition:
      opacity 300ms var(--ease-subtle),
      transform 400ms var(--ease-smooth);
  }
  .journal-row:hover .journal-row__thumb {
    opacity: 1;
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .journal-row:hover .journal-row__thumb {
      transform: none;
    }
  }
  .journal-row:first-child {
    border-block-start: 1px solid var(--color-line);
  }
  .journal-row__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--text-fine);
    color: var(--color-ink-muted);
  }
  .journal-row__cat {
    font-family: var(--font-eyebrow);
    font-size: var(--text-fine);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gold-dim);
  }
  .journal-row__title {
    font-size: var(--text-display-sm);
    color: var(--color-ink);
  }
  .journal-row__title a {
    transition: color 200ms var(--ease-subtle);
  }
  .journal-row__title a:hover {
    color: var(--color-gold);
  }
  .journal-row__dek {
    margin-block-start: 6px;
    font-size: var(--text-copy-sm);
    color: var(--color-ink-soft);
    max-inline-size: 55ch;
  }
  @media (max-width: 860px) {
    .journal-row {
      grid-template-columns: 132px 1fr;
    }
    .journal-row__thumb {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .journal-row {
      grid-template-columns: 1fr;
      gap: 8px;
      align-items: baseline;
    }
    .journal-row__meta {
      flex-direction: row;
      gap: 12px;
      align-items: center;
    }
  }
</style>
