---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import AccountDashboard from '../../components/islands/AccountDashboard.tsx';
---

<Base title="Your readings" description="View your bookings, readings and account." noindex={true}>
  <PageHeader variant="compact" heading="Your readings" />
  <section class="shell section-sm">
    <AccountDashboard client:only="preact" />
  </section>
</Base>

<style is:global>
  .dash {
    min-block-size: 400px;
  }
  .dash__greeting {
    font-family: var(--font-display);
    font-size: var(--text-display-sm);
    color: var(--color-ink);
    margin-block-end: 32px;
  }
  .dash__tabs {
    display: flex;
    gap: 32px;
    border-block-end: 1px solid var(--color-line);
    margin-block-end: 32px;
  }
  .dash__tab {
    background: none;
    border: none;
    border-block-end: 2px solid transparent;
    padding: 8px 0 12px;
    color: var(--color-ink-muted);
    font-size: var(--text-copy);
    font-weight: 500;
    cursor: pointer;
    transition: color 150ms var(--ease-subtle), border-color 150ms var(--ease-subtle);
  }
  .dash__tab:hover {
    color: var(--color-ink-soft);
  }
  .dash__tab--active {
    color: var(--color-ink);
    border-block-end-color: var(--color-gold);
  }
  .dash__tabs-skeleton {
    display: flex;
    gap: 32px;
    margin-block-end: 32px;
    padding-block-end: 12px;
    border-block-end: 1px solid var(--color-line);
  }
  .dash__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }
  .dash__booking {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }
  .dash__booking-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .dash__booking-service {
    font-family: var(--font-display);
    font-size: var(--text-display-sm);
    color: var(--color-ink);
  }
  .dash__booking-date {
    font-size: var(--text-copy-sm);
    color: var(--color-ink-soft);
  }
  .dash__booking-price {
    font-size: var(--text-copy-sm);
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .dash__reading {
    text-decoration: none;
    gap: 12px;
  }
  .dash__cards {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .dash__card-pill {
    display: inline-flex;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: var(--text-fine);
    font-weight: 500;
    color: var(--color-gold);
    border: 1px solid var(--color-line-gold);
  }
  .dash__reading-excerpt {
    font-size: var(--text-copy-sm);
    color: var(--color-ink-soft);
  }
  .dash__reading-date {
    font-size: var(--text-fine);
    color: var(--color-ink-muted);
  }
  .dash__empty,
  .dash__empty-tab {
    text-align: center;
    padding-block: 48px;
  }
  .dash__empty-heading {
    font-family: var(--font-display);
    font-size: var(--text-display-sm);
    color: var(--color-ink);
    margin-block-end: 12px;
  }
  .dash__empty-body {
    font-size: var(--text-copy);
    color: var(--color-ink-soft);
    max-inline-size: 46ch;
    margin-inline: auto;
  }
  .dash__empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-block-start: 24px;
  }
  .dash__profile-sections {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-inline-size: 520px;
  }
  .dash__section-heading {
    font-family: var(--font-display);
    font-size: var(--text-display-sm);
    color: var(--color-ink);
    margin-block-end: 20px;
  }
</style>
