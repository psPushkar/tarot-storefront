---
import Base from '../../layouts/Base.astro';
import Ornament from '../../components/Ornament.astro';
import AuthPanel from '../../components/islands/AuthPanel.tsx';
---

<Base title="Create an account" description="Create your account." noindex={true}>
  <section class="auth-page">
    <div class="auth-page__vesica" aria-hidden="true">
      <Ornament motif="vesica" size={320} />
    </div>
    <div class="auth-page__column shell">
      <h1 class="auth-page__sr-title">Create an account</h1>
      <AuthPanel mode="register" client:only="preact" />
    </div>
  </section>
</Base>
