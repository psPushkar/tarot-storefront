---
import Base from '../../layouts/Base.astro';
import Ornament from '../../components/Ornament.astro';
import AuthPanel from '../../components/islands/AuthPanel.tsx';
---

<Base title="Reset your password" description="Request a password reset." noindex={true}>
  <section class="auth-page">
    <div class="auth-page__vesica" aria-hidden="true">
      <Ornament motif="vesica" size={320} />
    </div>
    <div class="auth-page__column shell">
      <h1 class="auth-page__sr-title">Reset your password</h1>
      <AuthPanel mode="forgot" client:only="preact" />
    </div>
  </section>
</Base>
