---
import Base from '../../layouts/Base.astro';
import Ornament from '../../components/Ornament.astro';
import AuthPanel from '../../components/islands/AuthPanel.tsx';
---

<Base title="Set a new password" description="Choose a new password." noindex={true}>
  <section class="auth-page">
    <div class="auth-page__vesica" aria-hidden="true">
      <Ornament motif="vesica" size={320} />
    </div>
    <div class="auth-page__column shell">
      <h1 class="auth-page__sr-title">Set a new password</h1>
      <AuthPanel mode="reset" client:only="preact" />
    </div>
  </section>
</Base>
